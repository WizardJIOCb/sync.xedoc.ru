[Unit]
Description=Wizard Sync Syncthing stack
Requires=docker.service wizard-sync-vault.service
After=docker.service wizard-sync-vault.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/sync.xedoc.ru
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
